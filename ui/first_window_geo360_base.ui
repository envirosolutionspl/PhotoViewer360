  <property name="styleSheet">
   <string notr="true">QLabel#lbl_title { font-size: 16px; font-weight: 700; }
QLabel#lbl_subtitle { font-size: 11px; }
QToolButton#btn_help, QToolButton#btn_close { border: none; border-radius: 6px; padding: 3px; }
QLabel#lbl_email_7, QLabel#label_16 { font-size: 10px; }
QLabel#img_es_4 { background: transparent; padding: 0px; }

QTabBar { font-weight: 700; }
QTabBar::tab { padding: 6px 12px; margin-right: 3px; margin-top: 3px; border-top-left-radius: 6px; border-top-right-radius: 6px; font-weight: 700; }
QTabBar::tab:last { margin-right: 0px; }
QTabBar::tab:selected { margin-top: 0px; padding-bottom: 7px; margin-bottom: -1px; }
QWidget#tab1, QWidget#tab2, QWidget#tab3 { background: transparent; }

QLabel[role="field-title"] { font-weight: 700; }

QLineEdit, QComboBox { border-radius: 4px; padding: 3px 6px; min-height: 20px; }
QComboBox::drop-down { subcontrol-origin: padding; subcontrol-position: center right; width: 22px; border: none; }
QComboBox::down-arrow { image: url(pv360img:chevron_down.svg); width: 12px; height: 12px; }
QgsFileWidget &gt; QToolButton { border-radius: 4px; padding: 2px 6px; min-height: 19px; }

QPushButton { border-radius: 4px; padding: 5px 12px; min-height: 18px; }
QPushButton[role="primary"] { font-weight: 700; padding: 5px 16px; border: none; }

QPushButton:focus, QToolButton:focus, QTabBar:focus, QTabWidget:focus { outline: none; }
QToolButton#btn_help:focus, QToolButton#btn_close:focus { border: none; }

QDockWidget[theme="light"] QWidget#dockWidgetContents { background: #ffffff; }
QDockWidget[theme="light"] QLabel { color: #23282a; }
QDockWidget[theme="light"] QFrame#header_frame { background: #ffffff; border: none; border-bottom: 2px solid #4c6e4f; }
QDockWidget[theme="light"] QLabel#lbl_title { color: #3b5a3e; }
QDockWidget[theme="light"] QLabel#lbl_subtitle { color: #6b7572; }
QDockWidget[theme="light"] QToolButton#btn_help:hover, QDockWidget[theme="light"] QToolButton#btn_close:hover { background: #e8efe8; }
QDockWidget[theme="light"] QToolButton#btn_help { qproperty-icon: url(pv360img:help.svg); }
QDockWidget[theme="light"] QToolButton#btn_close { qproperty-icon: url(pv360img:close.svg); }
QDockWidget[theme="light"] QFrame#footer_frame { background: #f6f8f6; border: none; border-top: 1px solid #d6ded6; }

QDockWidget[theme="light"] QTabWidget#tabWidget_2 &gt; QStackedWidget { background: #ffffff; border: 1px solid #b9c7b9; border-top: none; border-bottom-left-radius: 6px; border-bottom-right-radius: 6px; }
QDockWidget[theme="light"] QTabBar { border-bottom: 1px solid #b9c7b9; }
